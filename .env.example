# Credentials for optional integrations. Local Ollama verification needs no keys.
# Non-secret provider settings live in config/providers.toml; exported variables
# such as EMBEDDING_PROVIDER and EMBEDDING_MODEL override those settings.
TAVILY_API_KEY=
# LlamaParse / LlamaCloud document parsing
LLAMA_CLOUD_API_KEY=
# Nebius integration is paused; this key is not read by local embeddings.
NEBIUS_API_KEY=
PINECONE_API_KEY=
# Optional future Mem0 Platform key; unused while memory is disabled.
MEM0_API_KEY=
LANGSMITH_API_KEY=
# LangChain and LangGraph do not require separate API keys.
# GitHub authentication should use your Git client, not this file.
